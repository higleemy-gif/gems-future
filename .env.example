# ---------------------------------------------------------------------------
# Gems Future — environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# ---------------------------------------------------------------------------

# Public Supabase config — safe to expose in the browser.
# The anon key is the ONLY Supabase key that may reach the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets. These must NEVER be prefixed with NEXT_PUBLIC_ and must
# NEVER be imported into client components. Used only in Edge Functions / server.
# ---------------------------------------------------------------------------

# service_role bypasses Row Level Security — server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API key — used ONLY inside a Supabase Edge Function, never the browser.
GEMINI_API_KEY=
