# Supabase (self-hosted via Coolify)
# Public values - safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (AI career counselling) - SERVER ONLY. Never expose to the client.
GEMINI_API_KEY=
# Set to a valid model your key supports (e.g. gemini-2.5-flash).
GEMINI_MODEL=gemini-3.8-flash


# Dev/testing only - set to true to bypass auth locally. Leave empty in production.
NEXT_PUBLIC_DISABLE_AUTH=
